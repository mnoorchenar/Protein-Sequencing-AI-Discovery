# AI features need one free API key. If both are set, Groq is used.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Hugging Face: https://huggingface.co/settings/tokens
# Needs the "Make calls to Inference Providers" permission. Free credits are small.
HF_TOKEN=

# Optional settings, shown with their defaults
PORT=7860
LOG_LEVEL=INFO
LLM_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HOPS=0
